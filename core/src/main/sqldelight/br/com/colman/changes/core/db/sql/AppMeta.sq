-- Metadados internos do banco. Uma única linha (id = 1). Não é exportado.
CREATE TABLE app_meta (
    id INTEGER NOT NULL PRIMARY KEY CHECK (id = 1),
    schema_version INTEGER NOT NULL,
    clinical_dataset_version INTEGER NOT NULL,
    last_export_at INTEGER
);

get:
SELECT * FROM app_meta WHERE id = 1;

insertDefault:
INSERT OR IGNORE INTO app_meta (id, schema_version, clinical_dataset_version, last_export_at)
VALUES (1, ?, 0, NULL);

setClinicalDatasetVersion:
UPDATE app_meta SET clinical_dataset_version = ? WHERE id = 1;

setSchemaVersion:
UPDATE app_meta SET schema_version = ? WHERE id = 1;

setLastExportAt:
UPDATE app_meta SET last_export_at = ? WHERE id = 1;
